    "autoprefixer": "^10.5.0",
    "baileys": "^7.0.0-rc11",
    "cron-parser": "^5.5.0",
    "deepseek": "^0.0.2",
    "keytar": "^7.9.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "openai": "^6.38.0",
    "postcss": "^8.5.14",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.11",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "undici": "^8.3.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
