{
  "name": "@circuitwall/jarela",
  "version": "1.10.4",
  "description": "Jarela — local chat interface for LangGraph agents (multi-provider, single-process, SQLite-backed).",
  "license": "Apache-2.0",
  "author": "Andrew Ge Wu",
  "homepage": "https://github.com/CircuitWall/jarela#readme",
  "bugs": {
    "url": "https://github.com/CircuitWall/jarela/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CircuitWall/jarela.git"
  },
  "keywords": [
    "langgraph",
    "llm",
    "chat",
    "agents",
    "mcp",
    "anthropic",
    "openai",
    "google-genai",
    "cohere",
    "deepseek",
    "self-hosted",
    "local-first",
    "nextjs",
    "pwa"
  ],
  "bin": {
    "jarela": "scripts/jarela-bin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": null,
    "./package.json": "./package.json",
    "./lib/providers/types": "./lib/providers/types.ts",
    "./lib/tools/types": "./lib/tools/types.ts",
    "./lib/tools/registry": "./lib/tools/registry.ts",
    "./lib/mcp/registry": "./lib/mcp/registry.ts"
  },
  "files": [
    ".next/standalone",
    "!.next/standalone/public/sw.js",
    "!.next/standalone/public/swe-worker-*.js",
    "app",
    "lib",
    "components",
    "contexts",
    "hooks",
    "api",
    "public",
    "!public/sw.js",
    "!public/swe-worker-*.js",
    "scripts/jarela-bin.mjs",
    "scripts/optimize-client-chunks.mjs",
    "scripts/service-install.mjs",
    "scripts/start-prod.mjs",
    "scripts/postbuild.mjs",
    "scripts/check-integration-manifests.mjs",
    "scripts/check-npm-package.mjs",
    "scripts/install-to-system.sh",
    "scripts/install-to-system.ps1",
    "scripts/installed-launcher.ps1",
    "scripts/installed-launcher.vbs",
    "scripts/install-tailscale-serve.ps1",
    "scripts/uninstall-tailscale-serve.ps1",
    "scripts/uninstall-from-system.ps1",
    "scripts/release-docker.mjs",
    "next.config.ts",
    "tsconfig.json",
    "postcss.config.mjs",
    "CHANGELOG.md",
    "docs/INSTALL.md"
  ],
  "scripts": {
    "setup:hooks": "node scripts/setup-git-hooks.mjs",
    "packages:build": "npm run build --workspaces --if-present",
    "packages:test": "npm run test --workspaces --if-present",
    "prepare": "npm run packages:build --silent 1>&2",
    "dev": "next dev --webpack -p 4312",
    "build": "npm run packages:build && next build --webpack && node scripts/postbuild.mjs",
    "start": "node scripts/start-prod.mjs",
    "lint": "eslint . && node scripts/check-integration-manifests.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/scan-secrets.mjs --all",
    "security:link-preview": "node scripts/check-link-preview-version.mjs",
    "security:routes": "node scripts/check-route-bundles.mjs",
    "security:ci": "npm run security:audit && npm run security:secrets && npm run security:link-preview",
    "pricing:snapshot": "node scripts/snapshot-pricing.mjs",
    "test:package": "node scripts/check-npm-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eval": "vitest run lib/agents/output-validator/eval.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e:coverage": "c8 --all --include \"tests/e2e/**/*.ts\" --reporter=text-summary --reporter=lcov --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 playwright test",
    "test:live": "node scripts/live-test.mjs",
    "test:live:full": "node scripts/live-test.mjs --llm",
    "test:live:isolated": "node scripts/live-test-isolated.mjs",
    "test:live:isolated:full": "node scripts/live-test-isolated.mjs --llm",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "promo:record": "node scripts/promo-record.mjs",
    "release:docker": "node scripts/release-docker.mjs",
    "release:docker:dry": "node scripts/release-docker.mjs --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@circuitwall/atlassian-langchain": "workspace:^",
    "@circuitwall/github-langchain": "workspace:^",
    "@circuitwall/jira-align-langchain": "workspace:^",
    "@langchain/cohere": "^1.0.5",
    "@langchain/core": "^1.1.46",
    "@langchain/deepseek": "^1.0.25",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/langgraph-checkpoint": "^1.0.2",
    "@langchain/mcp-adapters": "^1.1.3",
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "cron-parser": "^5.5.0",
    "cross-spawn": "^7.0.6",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "openai": "^6.38.0",
    "postcss": "^8.5.14",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "highlight.js": "^11.11.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "undici": "^8.3.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "overrides": {
    "qs": "^6.15.2",
    "uuid": "^11.1.1",
    "next": {
      "postcss": "$postcss"
    },
    "p-timeout": "^4.1.0",
    "@serwist/build": {
      "source-map": "^0.7.6"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@serwist/next": "^9.5.11",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.7",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "serwist": "^9.5.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
