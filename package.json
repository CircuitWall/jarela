{
  "name": "jarela",
  "version": "0.1.0",
  "description": "Jarela — local chat interface for LangGraph agents (multi-provider, single-process, SQLite-backed).",
  "license": "MIT",
  "bin": {
    "jarela": "./scripts/jarela-bin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "app",
    "lib",
    "components",
    "contexts",
    "hooks",
    "api",
    "public",
    "scripts/jarela-bin.mjs",
    "scripts/start-prod.mjs",
    "scripts/postbuild.mjs",
    "scripts/check-integration-manifests.mjs",
    "scripts/install-to-system.sh",
    "scripts/install-to-system.ps1",
    "scripts/installed-launcher.ps1",
    "scripts/installed-launcher.vbs",
    "scripts/install-tailscale-serve.ps1",
    "scripts/uninstall-tailscale-serve.ps1",
    "scripts/uninstall-from-system.ps1",
    "next.config.ts",
    "tsconfig.json",
    "postcss.config.mjs",
    "INSTALL.md"
  ],
  "scripts": {
    "dev": "next dev --webpack -p 4312",
    "build": "next build --webpack && node scripts/postbuild.mjs",
    "start": "node scripts/start-prod.mjs",
    "lint": "eslint . && node scripts/check-integration-manifests.mjs",
    "test:live": "node scripts/live-test.mjs",
    "test:live:full": "node scripts/live-test.mjs --llm",
    "test:live:isolated": "node scripts/live-test-isolated.mjs",
    "test:live:isolated:full": "node scripts/live-test-isolated.mjs --llm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@langchain/cohere": "^1.0.5",
    "@langchain/core": "^1.1.46",
    "@langchain/deepseek": "^1.0.25",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
