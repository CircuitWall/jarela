# Pin the public npm registry for everyone working in this repo.
#
# npm reads ~/.npmrc AND ./.npmrc, with the project-local file winning.
# This means contributors with a private mirror (e.g. JFrog, Verdaccio,
# Nexus) configured globally still resolve packages from the public
# registry while inside this repo, so package-lock.json never picks up
# internal-only URLs that public CI / Docker builds cannot reach.
#
# Auth tokens (if you ever need them) go in .npmrc.local, which is
# gitignored. Load them on demand with:
#   NPM_CONFIG_USERCONFIG=.npmrc.local npm install
registry=https://registry.npmjs.org/
fund=false
audit=false

# CI runners occasionally see ECONNRESET from the registry mid-install, which
# outlasts npm's default 2 retries. Retry longer before failing the job.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000