{
  "schemaVersion": 1,
  "entrypoint": "scripts/run.mjs",
  "files": ["scripts/run.mjs", "scripts/plan-cleanup.mjs"],
  "timeoutMs": 5000,
  "maxOutputBytes": 65536,
  "inputSchema": {
    "type": "object",
    "properties": {
      "now": { "type": "string", "minLength": 1 },
      "entries": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "kind": {
              "type": "string",
              "enum": ["preference", "fact", "decision", "constraint", "project_context", "contact", "task"]
            },
            "subject": { "type": "string", "minLength": 1 },
            "content": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "enum": ["active", "archived"] },
            "expires_at": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
          },
          "required": ["key", "kind", "subject", "content", "status", "expires_at"],
          "additionalProperties": false
        }
      }
    },
    "required": ["now", "entries"],
    "additionalProperties": false
  },
  "outputSchema": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "enum": [true] },
          "expired_keys": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
          "duplicate_groups": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          },
          "checks": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string", "enum": ["explicit_time", "expiry", "exact_kind_subject_content_expiry"] }
          },
          "limitation": { "type": "string", "minLength": 1 }
        },
        "required": ["ok", "expired_keys", "duplicate_groups", "checks", "limitation"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "enum": [false] },
          "error": { "type": "string", "minLength": 1 },
          "issues": {
            "type": "array",
            "minItems": 1,
            "maxItems": 101,
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 }
              },
              "required": ["path", "message"],
              "additionalProperties": false
            }
          }
        },
        "required": ["ok", "error", "issues"],
        "additionalProperties": false
      }
    ]
  }
}
