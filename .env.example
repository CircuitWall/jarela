# Copy to .env.local — values shown here are the defaults.
# All operational knobs are read once at startup via lib/env/config.ts.

# --- Server ----------------------------------------------------------------
# TCP port and bind address for the Next.js server. PORT/HOSTNAME also work
# (Next.js standalone reads those); JARELA_* takes precedence.
JARELA_PORT=4312
JARELA_HOSTNAME=127.0.0.1

# --- Storage ---------------------------------------------------------------
# Where SQLite + generated files live. Default: ~/.jarela (Unix),
# %LOCALAPPDATA%\Jarela (Windows). Tilde is expanded.
JARELA_DB_DIR=~/.jarela

# External tools dir (CJS/TS plugins loaded at startup). Defaults to
# $JARELA_DB_DIR/tools. Tilde is expanded.
JARELA_TOOLS_DIR=~/.jarela/tools

# External skills directory. Jarela scans for */SKILL.md (Claude-style) and
# *.md files and exposes them to agents via read_skill / write_skill tools.
# Point at a shared folder (e.g. ~/.skills) to share skills with VS Code
# Copilot and other tools that use the same SKILL.md convention.
# JARELA_SKILLS_DIR=~/.jarela/skills

# --- Agent runtime ---------------------------------------------------------
# Max LangGraph node visits per agent run before erroring out. Raise for
# legitimately deep multi-step tasks.
JARELA_RECURSION_LIMIT=200

# Per-request timeouts (ms) for Gemini voice (TTS/STT) and image generation.
JARELA_VOICE_TIMEOUT_MS=60000
JARELA_IMAGE_TIMEOUT_MS=60000

# Built-in web_search tries Tavily, Google Programmable Search, then
# DuckDuckGo by default. Google search also requires a Programmable Search
# Engine id (cx): https://programmablesearchengine.google.com/
JARELA_WEB_SEARCH_PROVIDER_ORDER=tavily,google,duckduckgo
# JARELA_GOOGLE_SEARCH_ENGINE_ID=

# --- Provider keys (also settable in the Models / Integrations panels) -----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GITHUB_TOKEN=

# --- Brand overlay (see docs/EXTENDING.md → Branding the app) --------------
# Rename/restyle the app without patching source. NEXT_PUBLIC_* is inlined at
# BUILD time, so changing any of these requires a rebuild, not a restart — and
# the prebuilt npm package cannot be rebranded this way; build from a fork.
# Rebranded builds keep a "Powered by Jarela" credit (ADR-0077).
# NEXT_PUBLIC_APP_NAME=Acme Assistant
# NEXT_PUBLIC_APP_SHORT_NAME=Acme
# NEXT_PUBLIC_APP_DESCRIPTION=Acme Assistant — internal agent console
# Your own bug tracker (upstream update checks stay pointed at Jarela).
# NEXT_PUBLIC_APP_ISSUE_URL=https://github.com/acme/assistant/issues/new
# Hex only; the hover shade is derived when left unset.
# NEXT_PUBLIC_APP_ACCENT_COLOR=#7c3aed
# NEXT_PUBLIC_APP_ACCENT_HOVER_COLOR=#6d28d9
# Easiest asset swap is replacing the files in public/ under the same names;
# set these only when your assets live elsewhere.
# NEXT_PUBLIC_APP_LOGO_LIGHT=/logo-mark-transparent.png
# NEXT_PUBLIC_APP_LOGO_DARK=/logo-mark-transparent-dark.png
