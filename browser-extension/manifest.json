{
  "manifest_version": 3,
  "name": "Jarela",
  "version": "0.1.2",
  "description": "Browser companion for Jarela: pick page elements, fill fields, rewrite text, and open the side panel.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "notifications", "contextMenus", "sidePanel", "cookies"],
  "optional_permissions": ["management"],
  "host_permissions": [
    "http://localhost:4312/*",
    "http://127.0.0.1:4312/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture an element to Jarela",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "fill-focused-field": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Jarela: open fill menu on focused field"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/helpers.mjs", "content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
