{
  "manifest_version": 3,
  "name": "Jarela Page Capture",
  "version": "0.1.0",
  "description": "Pick an element on any page and send it to your local Jarela agent.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "notifications"],
  "optional_permissions": ["management"],
  "host_permissions": [
    "http://localhost:4312/*",
    "http://127.0.0.1:4312/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Capture an element to Jarela",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/helpers.mjs", "content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
