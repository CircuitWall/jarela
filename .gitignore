# deps
node_modules/
.pnp
.pnp.js
# We commit a project-local .npmrc that pins the public npm registry so
# contributors who have a private mirror in ~/.npmrc don't accidentally
# leak internal URLs into package-lock.json. Auth tokens, if ever needed,
# belong in .npmrc.local (not read by npm automatically).
.npmrc.local

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# next-pwa generated service worker bundles (rebuilt on every `next build`).
# Keep public/manifest.json, icons, and static assets — only ignore generated JS.
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map
public/workbox-*.js
public/workbox-*.js.map
public/fallback-*.js

# build artifacts
dist/
build/
# `npm pack` output (used for local install testing)
*.tgz

# env
.env
.env.local
.env.*.local

# runtime/local state
*.db
*.sqlite
*.sqlite3
~/.jarela/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Root-level build/dev logs (hide clutter in ls)
.build*.log
.dev*.log
.dev.*.log
make-*.log
install-*.log
publish-*.log
docker-*.log
build-*.log
e2e-*.log

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.claude/

# test
coverage/

# playwright
test-results/
playwright-report/
playwright/.cache/

# archived
backend-archived/
node_modules
lint_output.txt

# survey output
.survey-long-functions.json

# assembled prompts (npm run prompts:dump)
.prompts/
